{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "price": {
              "type": "number",
              "minimum": 0
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["id", "name", "price", "quantity"]
        }
      },
      "total": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d{2})?$"
      },
      "count": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    },
    "required": ["items", "total", "count"]
  }
  